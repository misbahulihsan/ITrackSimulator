# ============================================================
# ITrack Simulator — Environment Configuration
# Salin file ini menjadi .env dan isi dengan nilai Anda sendiri
# JANGAN commit file .env ke Git!
# ============================================================

# Flask Session Secret Key (generate: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=ganti_dengan_random_string_panjang_minimal_32_karakter

# Kredensial Login Panel Kontrol
APP_USERNAME=admin
APP_PASSWORD=ihsan456

# CORS — domain yang diizinkan (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=https://simulator.misbahulihsan.com,http://192.168.18.8:8083,http://localhost:8083

# Aktifkan cookie Secure hanya jika diakses via HTTPS (true/false)
# Set false jika akses lokal (HTTP), true jika sudah pakai HTTPS/reverse proxy
COOKIE_SECURE=false
